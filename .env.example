# ==============================================================================
# KONFIGURASI LINGKUNGAN TERPADU — LOLOS CPNS (MONOREPO)
# Salin berkas ini menjadi `.env` di direktori utama, `/web/.env.local`, dan `/ai-service/.env`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI ADAPTOR AI TERPADU (BEBAS GANTI PENYEDIA TANPA UBAH KODE)
# Pilihan AI_PROVIDER: "gemini_free" | "groq_free" | "openrouter_free" | "ollama_local" | "custom_openai"
# ------------------------------------------------------------------------------
AI_PROVIDER="gemini_free"

# Default Tahap Awal: Google AI Studio Free Tier (Gratis Tanpa Kartu Kredit/Tagihan)
# Buat API Key gratis di: https://aistudio.google.com
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_API_KEY="masukkan_api_key_gratis_aistudio_anda"
AI_CHAT_MODEL="gemini-2.5-flash"
AI_VISION_MODEL="gemini-2.5-flash"
AI_EMBEDDING_MODEL="text-embedding-004"

# --- Alternatif 100% Gratis 1: Groq Free Tier ---
# AI_PROVIDER="groq_free"
# AI_BASE_URL="https://api.groq.com/openai/v1"
# AI_API_KEY="masukkan_api_key_gratis_groq_anda"
# AI_CHAT_MODEL="llama-3.3-70b-versatile"
# AI_VISION_MODEL="llama-3.2-90b-vision-preview"
# AI_EMBEDDING_MODEL=""

# ------------------------------------------------------------------------------
# 2. KONFIGURASI BASIS DATA & PENYIMPANAN SUPABASE (WAJIB UNTUK PRODUKSI)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://proyek-anda.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="masukkan_supabase_anon_key_anda"
SUPABASE_SERVICE_ROLE_KEY="masukkan_supabase_service_role_key_anda"
DATABASE_URL="postgresql://postgres:kata_sandi@db.proyek-anda.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. KONFIGURASI KOMUNIKASI & KEAMANAN ANTAR-LAYANAN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_INTERNAL_SECRET="ganti_kunci_rahasia_komunikasi_internal_nextjs_fastapi"
ALLOWED_ORIGINS="http://localhost:3000"
AI_SERVICE_PORT=8000

# ------------------------------------------------------------------------------
# 4. KONFIGURASI SESI PESERTA, MENU ADMIN, & GATEWAY PEMBAYARAN (WAJIB PRODUKSI)
# ------------------------------------------------------------------------------
USER_SESSION_SECRET="ganti_kunci_rahasia_sesi_peserta_minimal_32_karakter"
ADMIN_BOOTSTRAP_USERNAME="admin"
ADMIN_BOOTSTRAP_PASSWORD="ganti_kata_sandi_admin_awal_minimal_8_karakter"
ADMIN_SESSION_SECRET="ganti_kunci_rahasia_sesi_admin_minimal_32_karakter"

MIDTRANS_SERVER_KEY="masukkan_midtrans_server_key_anda"
MIDTRANS_CLIENT_KEY="masukkan_midtrans_client_key_anda"
MIDTRANS_IS_PRODUCTION="false"
